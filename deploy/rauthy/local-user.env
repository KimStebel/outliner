# The local app user, as opposed to Rauthy's own admin. Sourced by the scripts
# that generate the bootstrap data and by the ones that print it.
#
# `USER_ID` is pinned so `sub` is a known, stable value: the backend
# authorises against it, and local and production should not disagree about
# who the user is. A subject identifier is not a secret.
USER_ID=outlinerkimstebel0000001
USER_EMAIL=kim@localhost
USER_PASSWORD=LocalUserPassword123!
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=LocalAdminPassword123!
BASIC_USER=kim
BASIC_PASSWORD=LocalBasicPassword123!
