{
  "name": "outliner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "deploy": "./scripts/deploy.sh",
    "smoke": "npm run build && node scripts/smoke-prod.mjs",
    "auth": "./deploy/rauthy/rauthy-local.sh",
    "stack": "./deploy/stack-local.sh",
    "verify:oidc": "node scripts/verify-oidc.mjs",
    "verify:stack": "node scripts/verify-stack.mjs",
    "backups": "node scripts/backups.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
